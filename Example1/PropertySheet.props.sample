<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <APPDIR>D:\Games\YourGame</APPDIR>
    <APPEXE>YourGame.exe</APPEXE>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup />
  <ItemGroup>
    <BuildMacro Include="APPDIR">
      <Value>$(APPDIR)</Value>
    </BuildMacro>
    <BuildMacro Include="APPEXE">
      <Value>$(APPEXE)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>